{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "部屋の映像にキャラクターを表示するため、カメラを使用します。",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "部屋の温湿度センサーから記録を受け取るために Bluetooth を使います。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地の外の天気を取得し、部屋のカビやすさと比べるために位置情報を使います。",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MoldCharacter",
              "displayName": "キャラ",
              "description": "キャラの表情でカビのリスクを表示します",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/ios/CharacterWidget.tsx",
                "contentMarginsDisabled": true
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "src/widgets/android/CharacterWidget.tsx"
              }
            },
            {
              "name": "MoldHumidity",
              "displayName": "湿度",
              "description": "最新の湿度を表示します",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/ios/HumidityWidget.tsx"
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "src/widgets/android/HumidityWidget.tsx"
              }
            },
            {
              "name": "MoldTemperature",
              "displayName": "温度",
              "description": "最新の温度を表示します",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/ios/TemperatureWidget.tsx"
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "src/widgets/android/TemperatureWidget.tsx"
              }
            },
            {
              "name": "MoldSync",
              "displayName": "同期",
              "description": "デバイスと最後に同期した時刻を表示します",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/ios/SyncWidget.tsx"
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "src/widgets/android/SyncWidget.tsx"
              }
            },
            {
              "name": "MoldOverview",
              "displayName": "まとめ",
              "description": "キャラ・湿度・温度・同期時刻をまとめて表示します",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ios/OverviewWidget.tsx"
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "src/widgets/android/OverviewWidget.tsx"
              }
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jphacks.tkb2614"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
