diff --git a/android/src/main/java/expo/modules/widgets/RemoteViewsEmittable.kt b/android/src/main/java/expo/modules/widgets/RemoteViewsEmittable.kt
new file mode 100644
index 0000000000000000000000000000000000000000..2de61b9004d5a6e21e72762c14481381d072c406
--- /dev/null
+++ b/android/src/main/java/expo/modules/widgets/RemoteViewsEmittable.kt
@@ -0,0 +1,17 @@
+// EmittableAndroidRemoteViews is internal to Glance; its public counterpart is the AndroidRemoteViews
+// composable, which the emittable tree cannot call. Keep the access to this one file.
+@file:Suppress("INVISIBLE_MEMBER", "INVISIBLE_REFERENCE")
+
+package expo.modules.widgets
+
+import android.widget.RemoteViews
+import androidx.glance.Emittable
+import androidx.glance.GlanceModifier
+import androidx.glance.appwidget.EmittableAndroidRemoteViews
+
+internal fun createRemoteViewsEmittable(remoteViews: RemoteViews, modifier: GlanceModifier): Emittable {
+  return EmittableAndroidRemoteViews().also {
+    it.remoteViews = remoteViews
+    it.modifier = modifier
+  }
+}
