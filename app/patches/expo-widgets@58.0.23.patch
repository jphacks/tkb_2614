+/**
+ * Places a layout from the app's res/layout as is, for views Glance cannot express, such as a ProgressBar
+ * whose indeterminate drawable is an animated-rotate icon. `tint` is applied to the ProgressBar with the id
+ * `expo_widgets_tint_target` on Android 12+.
+ */
+private fun toRemoteLayout(converterContext: WidgetConverterContext, name: String, props: WidgetImageProps): Emittable {
+  val context = converterContext.applicationContext
+  val layoutId = context.resources.getIdentifier(name, "layout", context.packageName)
+  if (layoutId == 0) {
+    return createErrorText("Layout '$name' was not found in the app's res/layout.")
+  }
+  val remoteViews = RemoteViews(context.packageName, layoutId)
+  val tintTarget = context.resources.getIdentifier(REMOTE_LAYOUT_TINT_TARGET, "id", context.packageName)
+  val tint = props.tint
+  if (tint != null && tintTarget != 0 && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+    remoteViews.setColorStateList(tintTarget, "setIndeterminateTintList", ColorStateList.valueOf(tint.toArgb()))
+  }
+  return createRemoteViewsEmittable(remoteViews, props.imageModifier(converterContext))
