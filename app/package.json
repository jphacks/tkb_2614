{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo/ui": "~58.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.12",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "expo-widgets": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:mock": "cross-env EXPO_PUBLIC_MEASUREMENT_SOURCE=mock expo start --go",
